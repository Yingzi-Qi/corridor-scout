{
  "name": "corridor-scout",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --config vite.github.config.ts",
    "data:refresh": "python3 -m pipeline.run",
    "test:pipeline": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:data": "node --test tests/*.test.mjs",
    "test": "pnpm run test:pipeline && pnpm run test:data",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test && pnpm run build:pages"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
